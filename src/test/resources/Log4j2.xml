<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

<properties>

    <property name ="basePath">./logs</property>

</properties>

  <Appenders>
  
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
    </Console>
    
    <RollingFile name="File" fileName="${basePath}/automation.log" filePattern="${basePath}/automation-%d{yyyy-MM-dd}-%i.log">
     <PatternLayout  Pattern= " %d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
       <!-- Create a new file when it reaches 10 MB -->
                <SizeBasedTriggeringPolicy size="5000" />
         
    </RollingFile>
      </Appenders>
    
 
  <Loggers>
    <Root level="Debug"><!--Here you use multiple log levels All < Trace < Debug < Info < Warn < Error < Fatal < Off -->
    <!--AppenderRef ref="Console"/>--> 
      <AppenderRef ref="File"/>
    </Root>
  </Loggers>
</Configuration>